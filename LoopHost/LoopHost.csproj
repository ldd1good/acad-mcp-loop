<Project Sdk="Microsoft.NET.Sdk">

  <!-- AutoCAD 引用解析（AcadRefs 属性 / LOOP_ACAD_REFS 环境变量 / 已安装 acad），见该文件头 -->
  <Import Project="..\AcadRefs.props" />

  <PropertyGroup>
    <!-- ★ 本机 AutoCAD 2025 的 AcMgd/AcCoreMgd/AcDbMgd 为 .NET 8 程序集，
         原 net472 目标会触发 CS1705，故重定位到 net8.0-windows（README Limitations 亦提到需 retarget） -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LoopHost</RootNamespace>
    <AssemblyName>LoopHost</AssemblyName>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <!-- ★ LoopHost 不参与热重载（求稳）：版本固定，build.ps1 不得递增（见 mcp-loop-engine-plan.md §2.3-6） -->
    <Version>1.0.0</Version>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 运行时由 acad 进程提供，此处只影响编译期 API（Private=false 不拷贝） -->
    <Reference Include="AcMgd">
      <HintPath>$(AcadRefs)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AcadRefs)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AcadRefs)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- net8 下 System.Drawing 需显式包引用（截图功能用） -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
