<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LoopEngine</RootNamespace>
    <AssemblyName>LoopEngine</AssemblyName>
    <!-- 引擎版本（review P3-5）：serverInfo.version 此前恒 1.0.0 无法探测漂移；S2.5 修复轮 -->
    <!-- 1.2.0（2026-09-03）：撤销 B5 进程级单实例 → DrawingLock 同图纸互斥 + stderr 留话 -->
    <!-- 1.2.1（2026-09-03）：DRAWING_BUSY 判决补落台账/runs（复核 P2），历史不再漏计 -->
    <!-- 1.2.2（2026-09-11）：act 超时轮询恢复 + 静默确认循环（环窗/磁盘双源标记），长命令台账记真判决 -->
    <!-- 1.2.3（2026-09-11）：TailPaged 续读游标按行数推进——宿主旧 next_seq(写游标) 语义下翻页会整段跳日志 -->
    <!-- 1.2.4（2026-09-12）：fixture 实装(ARRANGE open|activate+DrawingLock 跟随)；list/diagnose 统计全量；
         黑名单按 Level 门控；SaveStage 原子写；恢复等待早探测；HostClient 块读+发现缓存；RoundtripKind -->
    <!-- 1.2.5（2026-09-12）：会话问题清单落地（docs/loop-engine-issues-2026-09-12.md）——
         P1-2 COLLECT 静默判据只认业务行(过滤 "host":" 噪声)+collect_tail_deadline_ms(90s)硬上限；
         P2-1 同 run_id 重复调用=块状续等；P2-2 BUSY holder 带 expected_release_at；
         P3-1 get_iteration 尾读+contains/level 过滤+运行中 live_tail；P1-1 hung 透传+CAD_HUNG
         fail-fast+abort_cad(引擎侧 Esc PostMessage 兜底)；P3-4 PASS+DONE:FAIL business_hint -->
    <Version>1.3.0</Version>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Windows-only by design (acad bridge); registry/PostMessage calls trip this analyzer -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- 用户级 SDK（C:\Users\lianxi\dotnet8）构建；PublishSingleFile 在发布时再开 -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- JsonNode/JsonObject/UTF8Encoding 在多个文件裸用；经全局 Using 统一引入 -->
    <Using Include="System.Text.Json.Nodes" />
    <Using Include="System.Text" />
  </ItemGroup>

</Project>
