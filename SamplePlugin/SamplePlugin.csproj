<Project Sdk="Microsoft.NET.Sdk">

  <!-- 示例业务插件：演示与 LoopHost 的集成契约（LoopToolRegistration + 白名单命令 + JSON 磁盘日志）。
       每次构建生成新 BuildGuid（嵌入 AssemblyMetadata + 写 <dll>.buildguid 边车文件），
       引擎据此做陈旧检测与热重载。 -->
  <Import Project="..\AcadRefs.props" />

  <PropertyGroup>
    <!-- ★ 同上：AutoCAD 2025 为 .NET 8 宿主，重定位到 net8.0-windows -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SamplePlugin</RootNamespace>
    <AssemblyName>SamplePlugin</AssemblyName>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <BuildGuid>$([System.Guid]::NewGuid().ToString("N"))</BuildGuid>
    <!-- ★ 关键：AutoCAD 宿主按 FullName 做字节热重载（同名同版本即 skip）。
         SamplePlugin 原写死 1.0.0.0 → 首次加载后热重载永久失效。
         这里把 Revision 派生为 BuildGuid 末 4 位 hex（每次 build 不同），
         使 FullName 唯一，热重载可反复生效。 -->
    <BuildGuidTail>$(BuildGuid.Substring(28, 4))</BuildGuidTail>
    <BuildRevision>$([System.Convert]::ToInt32($(BuildGuidTail), 16))</BuildRevision>
    <Version>1.0.0.$(BuildRevision)</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AcMgd">
      <HintPath>$(AcadRefs)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AcadRefs)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AcadRefs)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildGuid" Value="$(BuildGuid)" />
  </ItemGroup>

  <!-- buildguid 边车：引擎/宿主比对磁盘与内存的 BuildGuid，失配即触发业务代重载 -->
  <Target Name="WriteBuildGuidSidecar" AfterTargets="Build">
    <WriteLinesToFile File="$(TargetPath).buildguid" Lines="$(BuildGuid)" Overwrite="true" />
  </Target>

</Project>
